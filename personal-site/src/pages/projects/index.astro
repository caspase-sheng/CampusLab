---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';

// 列表不是写死的数组，而是每次构建遍历 projects 目录的结果。
// 所以往 src/content/projects/ 丢一个 .md，这个列表就自动多一张卡片。
// 过滤条件 !data.draft 把 draft: true 的条目挡在外面——它们的文件还在，但站点上看不到。
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="项目" description="我做过的项目">
  <h1 class="text-2xl font-semibold text-slate-900">项目</h1>
  <p class="mt-2 text-sm text-slate-500">共 {projects.length} 个</p>

  <div class="mt-6 grid gap-4">
    {
      projects.map((project) => (
        <EntryCard
          title={project.data.title}
          description={project.data.description}
          date={project.data.date}
          tags={project.data.tags}
          href={`/projects/${project.id}`}
          repo={project.data.repo}
        />
      ))
    }
  </div>
</BaseLayout>
