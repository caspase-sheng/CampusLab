---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
---

<BaseLayout title="关于" description={`关于 ${site.author.name}`}>
  <section>
    <h1 class="text-2xl font-semibold text-slate-900">关于</h1>

    <div class="mt-6 space-y-4 text-slate-600">
      <p>你好，我是{site.author.name}，{site.author.role}。</p>
      <p>{site.author.bio}</p>
      <p>
        这个站点是我自己用 Astro 5 + Tailwind 4 搭的，纯静态，不连后端也不调接口。
        写东西比刷题更有意思的地方在于，写下来的时候才发现自己原来没想清楚。
      </p>
    </div>
  </section>

  <section class="mt-8">
    <h2 class="text-sm font-medium text-slate-500">技能</h2>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
      {
        site.skills.map((skill) => (
          <li class="rounded border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700">
            {skill}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="text-sm font-medium text-slate-500">联系我</h2>
    <ul class="mt-3 flex flex-wrap gap-4 text-sm">
      {
        site.socials.map((s) => (
          <li>
            <a
              href={s.href}
              class="text-slate-700 underline underline-offset-2 transition-colors hover:text-slate-900"
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
