---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { withBase } from '../lib/paths';

// 首页：一句话自我介绍 + 三个入口 + 最近 3 篇博客。
// getCollection 在构建期遍历内容目录，所以下面这些数字不是写死的。
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recent = posts.slice(0, 3);

const sections = [
  { href: '/projects', title: '项目', desc: '做过的项目，写实的那种' },
  { href: '/blog', title: '博客', desc: '实现思路和踩坑记录' },
  { href: '/notes', title: '笔记', desc: '零散的技术碎片' },
];
---

<BaseLayout>
  <section>
    <h1 class="text-2xl font-semibold text-slate-900">{site.author.name}</h1>
    <p class="mt-1 text-sm text-slate-500">{site.author.role}</p>
    <p class="mt-4 text-slate-600">{site.author.bio}</p>
  </section>

  <section class="mt-8 grid gap-4 sm:grid-cols-3">
    {
      sections.map((s) => (
        <a
          href={withBase(s.href)}
          class="rounded-lg border border-slate-200 bg-white p-4 transition-colors hover:border-slate-300"
        >
          <h2 class="text-base font-medium text-slate-900">{s.title}</h2>
          <p class="mt-1 text-sm text-slate-600">{s.desc}</p>
        </a>
      ))
    }
  </section>

  <section class="mt-10">
    <div class="flex items-baseline justify-between">
      <h2 class="text-sm font-medium text-slate-500">最近博客</h2>
      <a href={withBase('/blog')} class="text-sm text-slate-500 transition-colors hover:text-slate-900">
        全部 →
      </a>
    </div>
    <ul class="mt-3 divide-y divide-slate-200 border-t border-slate-200">
      {
        recent.map((post) => (
          <li class="flex items-baseline justify-between gap-3 py-3">
            <a href={withBase(`/blog/${post.id}`)} class="text-slate-800 hover:underline">
              {post.data.title}
            </a>
            <time class="shrink-0 text-xs text-slate-500" datetime={post.data.date.toISOString()}>
              {post.data.date.toISOString().slice(0, 10)}
            </time>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
