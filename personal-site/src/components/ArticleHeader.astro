---
// 详情页顶部的标题 + 日期 + 标签（+ 可选的仓库/演示链接）。
// 项目、博客、笔记三个详情页共用，避免重复排版逻辑。

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  repo?: string;
  demo?: string;
}

const { title, date, tags = [], repo, demo } = Astro.props;
const iso = date.toISOString();
---

<header class="border-b border-slate-200 pb-6">
  <h1 class="text-2xl font-semibold text-slate-900">{title}</h1>
  <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-500">
    <time datetime={iso}>{iso.slice(0, 10)}</time>
    {
      tags.map((tag) => (
        <span class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600">{tag}</span>
      ))
    }
    {
      (repo || demo) && (
        <span class="ml-auto flex gap-3 text-xs">
          {repo && (
            <a href={repo} class="transition-colors hover:text-slate-900">
              仓库
            </a>
          )}
          {demo && (
            <a href={demo} class="transition-colors hover:text-slate-900">
              演示
            </a>
          )}
        </span>
      )
    }
  </div>
</header>
