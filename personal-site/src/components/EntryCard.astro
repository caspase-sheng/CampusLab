---
// 列表页统一的条目卡片。项目 / 博客 / 笔记三个列表共用。
// repo 是项目列表独有，传了才显示「仓库」链接。

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
  href: string;
  repo?: string;
}

const { title, description, date, tags = [], href, repo } = Astro.props;
const iso = date.toISOString();
const dateText = iso.slice(0, 10);
---

<article
  class="rounded-lg border border-slate-200 bg-white p-5 transition-colors hover:border-slate-300"
>
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-lg font-medium text-slate-900">
      <a href={href} class="hover:underline">{title}</a>
    </h2>
    <time class="shrink-0 text-xs text-slate-500" datetime={iso}>{dateText}</time>
  </div>

  {description && <p class="mt-2 text-sm text-slate-600">{description}</p>}

  <div class="mt-3 flex flex-wrap items-center gap-2">
    {
      tags.map((tag) => (
        <span class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600">{tag}</span>
      ))
    }
    {repo && (
      <a
        href={repo}
        class="ml-auto text-xs text-slate-500 transition-colors hover:text-slate-900"
      >
        仓库 →
      </a>
    )}
  </div>
</article>
